#!/usr/bin/env bash
# rusty-modbus fast pre-commit gate — mirrors the cheap PR->dev CI.
# Heavy checks (clippy, tests) run in .githooks/pre-push and the release gate.
# Skip once:    git commit --no-verify
# Skip session: export RUSTY_MODBUS_SKIP_HOOKS=1
set -euo pipefail
[ -n "${RUSTY_MODBUS_SKIP_HOOKS:-}" ] && { echo "[pre-commit] skipped (RUSTY_MODBUS_SKIP_HOOKS)"; exit 0; }
cd "$(git rev-parse --show-toplevel)"

echo "[pre-commit] cargo fmt --all --check"
cargo fmt --all --check

echo "[pre-commit] ok"
